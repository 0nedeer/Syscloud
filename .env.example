# Copy to .env and replace the local development passwords before running.
# Local MySQL: create this dedicated database/user first (see docs/development.md).
# URL-encode special characters in DATABASE_URL username/password.
DATABASE_URL=mysql+asyncmy://recordings:change-me-local@127.0.0.1:3306/recordings?charset=utf8mb4
UPLOAD_DIR=./data/recordings
LOG_LEVEL=INFO
DB_CONNECT_TIMEOUT_SECONDS=5
DB_READ_TIMEOUT_SECONDS=5
DB_POOL_TIMEOUT_SECONDS=5
READINESS_TIMEOUT_SECONDS=3

# Compose substitutes its own database hostname and URL using these values.
# Use URL-safe passwords here, e.g. random letters/digits/hyphens/underscores.
MYSQL_DATABASE=recordings
MYSQL_USER=recordings
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
API_PORT=8000

# Required for Worker: choose the actual provider, protocol and accessible model.
# Keep the real key only in an ignored .env/.env.docker or process environment.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_STYLE=responses
# Optional for models that support reasoning; omit for other models.
# LLM_REASONING_EFFORT=high
# Set explicitly when the model service requires a proxy; HTTPX does not read Windows settings.
LLM_PROXY_URL=
LLM_MODEL=replace-with-accessible-model
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_RESPONSE_BYTES=262144
WORKER_CONCURRENCY=3
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=120
WORKER_HEARTBEAT_SECONDS=10
WORKER_SHUTDOWN_SECONDS=10
WORKER_CLEANUP_SECONDS=10
